// use prisma-8

enum Status {
  @@type("pg/text@1")
  Open        = "open"
  InProgress  = "in_progress"
  Closed      = "closed"
}

enum Priority {
  @@type("pg/text@1")
  Low    = "low"
  Medium = "medium"
  High   = "high"
}

model Ticket {
  id          Uuid     @id @default(uuid())
  title       String
  description String?
  status      Status   @default(Open)
  priority    Priority @default(Low)
  createdAt   DateTime @default(now())

  @@map("ticket")
  @@index([status, priority])
}
